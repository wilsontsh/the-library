y to visit the former housekeeper, Miss Kenton. Along the way he looks back on his years serving Lord Darlington between the wars.", "quotes": [], "notes": "", "links": [], "dateRead": null, "sample": true, "createdAt": 1790000000014, "subjects": ["country house", "memory", "unreliable narrator"], "publisher": "Faber & Faber"}, "ex-15-never-let-me-go": {"title": "Never Let Me Go", "titleAlt": "別讓我走", "author": "Kazuo Ishiguro", "year": 2005, "genre": "Fiction", "subgenre": "Literary fiction", "status": "read", "rating": null, "feelings": [], "review": "", "pullLine": "", "synopsis": "", "quotes": [], "notes": "", "links": [], "dateRead": null, "sample": true, "createdAt": 1790000000015}, "ex-16-an-artist-of-the-floating-world": {"title": "An Artist of the Floating World", "titleAlt": null, "author": "Kazuo Ishiguro", "year": 1986, "genre": "Fiction", "subgenre": "Literary fiction", "status": "read", "rating": null, "feelings": [], "review": "", "pullLine": "", "synopsis": "", "quotes": [], "notes": "", "links": [], "dateRead": null, "sample": true, "createdAt": 1790000000016}, "ex-17-klara-and-the-sun": {"title": "Klara and the Sun", "titleAlt": null, "author": "Kazuo Ishiguro", "year": 2021, "genre": "Fiction", "subgenre": "Literary fiction", "status": "read", "rating": null, "feelings": [], "review": "", "pullLine": "", "synopsis": "", "quotes": [], "notes": "", "links": [], "dateRead": null, "sample": true, "createdAt": 1790000000017}, "ex-18-the-buried-giant": {"title": "The Buried Giant", "titleAlt": null, "author": "Kazuo Ishiguro", "year": 2015, "genre": "Fiction", "subgenre": "Literary fiction", "status": "read", "rating": null, "feelings": [], "review": "", "pullLine": "", "synopsis": "", "quotes": [], "notes": "", "links": [], "dateRead": null, "sample": true, "createdAt": 1790000000018}, "ex-19-atonement": {"title": "Atonement", "titleAlt": null, "author": "Ian McEwan", "year": 2001, "genre": "Fiction", "subgenre": "Literary fiction", "status": "read", "r